<?xml version="1.0" encoding="utf-8"?>
<!-- necookey の設定。ホームの4カテゴリが screen_* を rootKey として開く。
     各カテゴリ末尾の screen_*_advanced（詳細設定）は同じ画面クラスで入れ子として開く。 -->
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceScreen
            android:key="screen_keyboard"
            android:title="@string/home_category_keyboard"
            app:iconSpaceReserved="false">
        <PreferenceCategory
            android:title="@string/settings_section_look"
            app:iconSpaceReserved="false">
            <Preference
                android:key="custom_keyboard_list_preference"
                android:summary="@string/custom_keyboard_list_preference_summary"
                android:title="@string/custom_layout_fragment_title"
                app:iconSpaceReserved="false" />
            <Preference
                android:key="keyboard_screen_preference"
                android:summary="@string/keyboard_screen_preference_summary"
                android:title="@string/keyboard_screen_size_preference_title"
                app:iconSpaceReserved="false" />
            <Preference
                android:key="keyboard_key_letter_size_fragment_preference"
                android:summary="@string/key_candidate_letter_size_preference_summary"
                android:title="@string/key_candidate_letter_size_preference_title"
                app:iconSpaceReserved="false" />
            <Preference
                android:key="candidate_view_height_setting_fragment_preference"
                android:title="@string/candidate_height_preference_title"
                app:summary="@string/candidate_height_preference_sumary"
                app:iconSpaceReserved="false" />
        </PreferenceCategory>
        <PreferenceCategory
            android:title="@string/settings_section_input"
            app:iconSpaceReserved="false">
            <SeekBarPreference
                android:defaultValue="100"
                android:key="flick_sensitivity_preference"
                android:max="200"
                android:title="@string/flick_sensitivity_title"
                app:min="1"
                app:seekBarIncrement="5"
                app:showSeekBarValue="true"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="undo_enable_preference"
                android:summary="@string/undo_enable_summary"
                android:title="@string/undo_enable_title"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="space_key_preference"
                android:summary="@string/space_key_summary"
                android:title="@string/space_key_title"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="conversion_key_swipe_cursor_move_preference"
                android:summary="@string/pref_summary_space_longpress_cursor"
                android:title="@string/pref_title_space_longpress_cursor"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:defaultValue="true"
                android:key="delete_key_flick_left_preference"
                android:summary="@string/delete_key_left_summary"
                android:title="@string/delete_key_left_flick_title"
                app:iconSpaceReserved="false" />
            <Preference
                android:dependency="delete_key_flick_left_preference"
                android:key="delete_key_flick_left_targets_preference"
                android:summary="@string/delete_key_flick_targets_summary"
                android:title="@string/delete_key_flick_targets_title"
                app:iconSpaceReserved="false" />
        </PreferenceCategory>
        <PreferenceScreen
                android:key="screen_keyboard_advanced"
                android:title="@string/settings_advanced_title"
                android:summary="@string/settings_advanced_summary"
                app:iconSpaceReserved="false">
            <PreferenceCategory
                android:title="@string/settings_section_key_behavior"
                app:iconSpaceReserved="false">
                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="henkan_delete_key_action_preference"
                    android:summaryOff="@string/henkan_delete_key_action_summary_off"
                    android:summaryOn="@string/henkan_delete_key_action_summary_on"
                    android:title="@string/henkan_delete_key_action_title"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="custom_direct_mode_space_hankaku_preference"
                    android:summary="@string/custom_direct_mode_space_hankaku_summary"
                    android:title="@string/custom_direct_mode_space_hankaku_title"
                    app:iconSpaceReserved="false" />
                <Preference
                    android:key="cursor_move_after_commit_target_pairs_preference"
                    android:summary="@string/cursor_move_target_pairs_summary"
                    android:title="@string/cursor_move_target_pairs_title"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:key="save_last_used_keyboard"
                    android:title="@string/save_last_used_keyboard_title"
                    app:defaultValue="false"
                    app:summary="@string/save_last_used_keyboard_summey"
                    app:iconSpaceReserved="false" />
                <ListPreference
                    android:defaultValue="default"
                    android:entries="@array/type_null_input_behavior_entries"
                    android:entryValues="@array/type_null_input_behavior_values"
                    android:key="type_null_input_behavior_preference"
                    android:summary="%s"
                    android:title="@string/type_null_input_behavior_title"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
            <PreferenceCategory
                android:title="@string/category_symbol_keyboard_title"
                app:iconSpaceReserved="false">
                <ListPreference
                    android:defaultValue="EMOJI"
                    android:dialogTitle="@string/symbol_mode_dialog_title"
                    android:entries="@array/symbol_mode_entries"
                    android:entryValues="@array/symbol_mode_values"
                    android:key="symbol_mode_preference"
                    android:summary="@string/symbol_mode_summary"
                    android:title="@string/symbol_mode_title"
                    app:iconSpaceReserved="false" />
                <ListPreference
                    android:defaultValue="default"
                    android:dialogTitle="@string/default_emoji_skin_tone_dialog_title"
                    android:entries="@array/default_emoji_skin_tone_entries"
                    android:entryValues="@array/default_emoji_skin_tone_values"
                    android:key="default_emoji_skin_tone_preference"
                    android:summary="@string/default_emoji_skin_tone_summary"
                    android:title="@string/default_emoji_skin_tone_title"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceScreen>

    <PreferenceScreen
            android:key="screen_conversion"
            android:title="@string/home_category_conversion"
            app:iconSpaceReserved="false">
        <PreferenceCategory
            android:title="@string/settings_section_candidates"
            app:iconSpaceReserved="false">
            <SwitchPreferenceCompat
                android:key="necookey_two_row_candidate_bar_preference"
                android:title="@string/necookey_two_row_candidate_bar_title"
                app:defaultValue="true"
                app:summary="@string/necookey_two_row_candidate_bar_summary"
                app:iconSpaceReserved="false" />
            <ListPreference
                android:defaultValue="1"
                android:dialogTitle="@string/preference_dialog_title_num_columns_conversion"
                android:entries="@array/candidate_column_entries"
                android:entryValues="@array/candidate_column_values"
                android:key="candidate_column_preference"
                android:summary="@string/preference_summary_num_column_conversion"
                android:title="@string/preference_title_num_columns_conversion"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:defaultValue="true"
                android:key="emoji_candidate_enable_preference"
                android:summary="@string/emoji_candidate_enable_summary"
                android:title="@string/emoji_candidate_enable_title"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:defaultValue="true"
                android:key="symbol_candidate_enable_preference"
                android:summary="@string/symbol_candidate_enable_summary"
                android:title="@string/symbol_candidate_enable_title"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:defaultValue="true"
                android:key="emoticon_candidate_enable_preference"
                android:summary="@string/emoticon_candidate_enable_summary"
                android:title="@string/emoticon_candidate_enable_title"
                app:iconSpaceReserved="false" />
        </PreferenceCategory>
        <PreferenceCategory
            android:key="zenz_category"
            android:title="zenz"
            app:iconSpaceReserved="false">
            <SwitchPreferenceCompat
                android:key="necookey_zenz_bunsetsu_gate_preference"
                android:title="@string/necookey_zenz_bunsetsu_gate_title"
                app:defaultValue="true"
                app:summary="@string/necookey_zenz_bunsetsu_gate_summary"
                app:iconSpaceReserved="false" />
            <ListPreference
                android:key="zenz_engine_preference"
                android:title="@string/zenz_engine_title"
                android:defaultValue="zenz"
                android:entries="@array/zenz_engine_entries"
                android:entryValues="@array/zenz_engine_values"
                app:useSimpleSummaryProvider="true"
                app:iconSpaceReserved="false" />
            <SeekBarPreference
                android:defaultValue="50"
                android:key="sumire_lm_zenz_margin_preference"
                android:max="300"
                android:title="@string/sumire_lm_zenz_margin_title"
                android:summary="@string/sumire_lm_zenz_margin_summary"
                app:min="0"
                app:showSeekBarValue="true"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:key="lattice_lm_cost_preference"
                android:title="@string/lattice_lm_cost_title"
                app:defaultValue="true"
                app:summary="@string/lattice_lm_cost_summary"
                app:iconSpaceReserved="false" />
            <Preference
                android:key="zenz_model_select_preference"
                android:title="@string/zenz_model_source_title"
                app:summary="@string/zenz_model_source_default"
                app:iconSpaceReserved="false" />
            <Preference
                android:key="zenz_diagnostics_preference"
                android:title="@string/zenz_diagnostics_title"
                app:summary="@string/zenz_diagnostics_entry_summary"
                app:iconSpaceReserved="false" />
        </PreferenceCategory>
        <PreferenceScreen
                android:key="screen_conversion_advanced"
                android:title="@string/settings_advanced_title"
                android:summary="@string/settings_advanced_summary"
                app:iconSpaceReserved="false">
            <PreferenceCategory
                android:title="@string/settings_section_candidate_detail"
                app:iconSpaceReserved="false">
                <SwitchPreferenceCompat
                    android:defaultValue="false"
                    android:key="stabilize_candidate_strip_height_preference"
                    android:title="@string/stabilize_candidate_strip_height_title"
                    android:summary="@string/stabilize_candidate_strip_height_summary"
                    app:iconSpaceReserved="false" />
                <SeekBarPreference
                    android:defaultValue="4"
                    android:key="n_best_preference"
                    android:max="16"
                    android:summary="@string/n_best_preference_summary"
                    android:title="N-Best"
                    app:min="2"
                    app:showSeekBarValue="true"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:defaultValue="false"
                    android:key="reconversion_preference"
                    android:title="@string/reconversion_preference_title"
                    app:summary="@string/reconversion_preference_summary"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="inline_suggestion_enabled_preference"
                    android:summaryOff="@string/inline_suggestion_enabled_summary_off"
                    android:summaryOn="@string/inline_suggestion_enabled_summary_on"
                    android:title="@string/inline_suggestion_enabled_title"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:key="conversion_candidates_romaji_enable_preference"
                    android:title="@string/conversion_candidates_romaji_enable_preference_title"
                    app:defaultValue="false"
                    app:summary="@string/conversion_candidates_romaji_enable_preference_summary"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="english_reading_dictionary_enable_preference"
                    android:summary="@string/english_reading_dictionary_enable_summary"
                    android:title="@string/english_reading_dictionary_enable_title"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:defaultValue="false"
                    android:key="incremental_conversion_session_preference"
                    android:summaryOff="@string/incremental_conversion_session_summary_off"
                    android:summaryOn="@string/incremental_conversion_session_summary_on"
                    android:title="@string/incremental_conversion_session_title"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
            <PreferenceCategory
                android:title="@string/typo_correction_title"
                app:iconSpaceReserved="false">
                <SwitchPreferenceCompat
                    android:key="enable_typo_correction_japanese_flick_keyboard_preference"
                    android:title="@string/enable_typo_correction_japanese_flick_keyboard_preference_title"
                    app:defaultValue="false"
                    app:summary="@string/enable_typo_correction_japanese_flick_keyboard_preference_sumary"
                    app:iconSpaceReserved="false" />
                <SeekBarPreference
                    android:key="enable_typo_correction_japanese_flick_keyboard_offset_score_preference"
                    android:max="5000"
                    android:title="@string/enable_typo_correction_japanese_flick_keyboard_offset_score_preference_tittle"
                    app:defaultValue="3000"
                    app:min="0"
                    app:seekBarIncrement="10"
                    app:showSeekBarValue="true"
                    app:summary="@string/enable_typo_correction_japanese_flick_keyboard_offset_score_preference_summary"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:key="enable_typo_correction_qwerty_english_keyboard_preference"
                    android:title="@string/enable_typo_correction_qwerty_english_keyboard_preference_title"
                    app:defaultValue="false"
                    app:summary="@string/enable_typo_correction_qwerty_english_keyboard_preference_summary"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:defaultValue="false"
                    android:key="omission_search_preference"
                    android:summaryOff="@string/omission_search_summary_off"
                    android:summaryOn="@string/omission_search_summary_on"
                    android:title="@string/omission_search_title"
                    app:iconSpaceReserved="false" />
                <SeekBarPreference
                    android:key="omission_search_preference_offset_score_preference"
                    android:max="5000"
                    android:title="@string/omission_search_preference_offset_score_preference_title"
                    app:defaultValue="1900"
                    app:min="0"
                    app:seekBarIncrement="10"
                    app:showSeekBarValue="true"
                    app:summary="@string/omission_search_preference_offset_score_preference_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
            <PreferenceCategory
                android:key="zenz_advanced_category"
                android:title="zenz"
                app:iconSpaceReserved="false">
                <SwitchPreferenceCompat
                    android:key="enable_zenz_right_context_preference"
                    android:title="@string/enable_zenz_right_context_preference_title"
                    app:defaultValue="false"
                    app:summary="@string/enable_zenz_right_context_preference_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceScreen>

    <PreferenceScreen
            android:key="screen_dictionary"
            android:title="@string/home_category_dictionary"
            app:iconSpaceReserved="false">
        <PreferenceCategory
            android:title="@string/home_dictionary_manage_category"
            app:iconSpaceReserved="false">
            <Preference
                android:key="home_user_dictionary_preference"
                android:summary="@string/home_user_dictionary_summary"
                android:title="@string/user_dictionary_title"
                app:iconSpaceReserved="false" />
            <Preference
                android:key="home_learn_dictionary_preference"
                android:summary="@string/home_learn_dictionary_summary"
                android:title="@string/learn_dictionary_fragment_title"
                app:iconSpaceReserved="false" />
            <Preference
                android:key="ng_word_list_preference"
                android:summary="@string/ng_word_list_summary"
                android:title="@string/ng_word_list_title"
                app:iconSpaceReserved="false" />
        </PreferenceCategory>
        <PreferenceCategory
            android:title="@string/settings_section_next_word"
            app:iconSpaceReserved="false">
            <Preference
                android:key="next_word_learning_view_preference"
                android:title="@string/next_word_learning_view_title"
                app:iconSpaceReserved="false" />
            <Preference
                android:key="next_word_learning_clear_preference"
                android:title="@string/next_word_learning_clear_title"
                android:summary="@string/next_word_learning_clear_summary"
                app:iconSpaceReserved="false" />
        </PreferenceCategory>
        <PreferenceScreen
                android:key="screen_dictionary_advanced"
                android:title="@string/settings_advanced_title"
                android:summary="@string/settings_advanced_summary"
                app:iconSpaceReserved="false">
            <PreferenceCategory
                android:title="@string/settings_ut_dictionary_category"
                app:iconSpaceReserved="false">
                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="ut_person_name_enabled_preference"
                    android:title="@string/settings_ut_person_title"
                    android:summary="@string/settings_ut_person_summary"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="ut_places_enabled_preference"
                    android:title="@string/settings_ut_places_title"
                    android:summary="@string/settings_ut_places_summary"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="ut_wiki_enabled_preference"
                    android:title="@string/settings_ut_wiki_title"
                    android:summary="@string/settings_ut_wiki_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
            <PreferenceCategory
                android:title="@string/settings_section_learning"
                app:iconSpaceReserved="false">
                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="learn_dictionary_preference"
                    android:summaryOff="@string/learn_dictionary_summary_off"
                    android:summaryOn="@string/learn_dictionary_summary_on"
                    android:title="@string/learn_dictionary_title"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:dependency="learn_dictionary_preference"
                    android:key="learn_first_candidate_dictionary_preference"
                    android:title="@string/learn_dictionary_preference_title"
                    app:defaultValue="false"
                    app:summary="@string/learn_dictionary_preference_summary"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:dependency="learn_dictionary_preference"
                    android:key="learn_dictionary_allow_mixed_symbols_numbers_preference"
                    android:title="@string/learn_dictionary_allow_mixed_symbols_numbers_title"
                    app:defaultValue="true"
                    app:summary="@string/learn_dictionary_allow_mixed_symbols_numbers_summary"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:dependency="learn_dictionary_preference"
                    android:key="enable_prediction_search_learn_dictionary_preference"
                    android:title="@string/enable_prediction_search_learn_dictionary_preference_titile"
                    app:defaultValue="false"
                    app:summary="@string/enable_prediction_search_learn_dictionary_preference_summary"
                    app:iconSpaceReserved="false" />
                <SeekBarPreference
                    android:defaultValue="4"
                    android:dependency="enable_prediction_search_learn_dictionary_preference"
                    android:key="learn_prediction_preference"
                    android:max="8"
                    android:title="@string/user_dictionary_prefix_match_title"
                    app:min="1"
                    app:showSeekBarValue="true"
                    app:iconSpaceReserved="false" />
                <SeekBarPreference
                    android:defaultValue="4"
                    android:dependency="enable_prediction_search_learn_dictionary_preference"
                    android:key="learn_dictionary_prediction_candidate_limit_preference"
                    android:max="8"
                    android:summary="@string/learn_dictionary_prediction_candidate_limit_summary"
                    android:title="@string/dictionary_prediction_candidate_limit_title"
                    app:min="1"
                    app:showSeekBarValue="true"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="system_ngram_dictionary_enable_preference"
                    android:summaryOff="@string/system_ngram_dictionary_enable_summary_off"
                    android:summaryOn="@string/system_ngram_dictionary_enable_summary_on"
                    android:title="@string/system_ngram_dictionary_enable_title"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
            <PreferenceCategory
                android:title="@string/user_dictionary_title"
                app:iconSpaceReserved="false">
                <SwitchPreferenceCompat
                    android:defaultValue="true"
                    android:key="user_dictionary_preference"
                    android:summaryOff="@string/user_dictionary_summary_off"
                    android:summaryOn="@string/user_dictionary_summary_on"
                    android:title="@string/user_dictionary_title"
                    app:iconSpaceReserved="false" />
                <SeekBarPreference
                    android:defaultValue="2"
                    android:dependency="user_dictionary_preference"
                    android:key="user_dictionary_prefix_match_number"
                    android:max="8"
                    android:title="@string/user_dictionary_prefix_match_title"
                    app:min="2"
                    app:showSeekBarValue="true"
                    app:iconSpaceReserved="false" />
                <SeekBarPreference
                    android:defaultValue="4"
                    android:dependency="user_dictionary_preference"
                    android:key="user_dictionary_prediction_candidate_limit_preference"
                    android:max="8"
                    android:summary="@string/user_dictionary_prediction_candidate_limit_summary"
                    android:title="@string/dictionary_prediction_candidate_limit_title"
                    app:min="1"
                    app:showSeekBarValue="true"
                    app:iconSpaceReserved="false" />
                <SwitchPreferenceCompat
                    android:defaultValue="false"
                    android:key="preserve_dictionary_word_whitespace_preference"
                    android:title="@string/preserve_dictionary_word_whitespace_title"
                    app:iconSpaceReserved="false"
                    app:summary="@string/preserve_dictionary_word_whitespace_summary" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceScreen>

    <PreferenceScreen
            android:key="screen_other"
            android:title="@string/home_category_other"
            app:iconSpaceReserved="false">
        <PreferenceCategory
            android:title="@string/clipboard_history_title"
            app:iconSpaceReserved="false">
            <Preference
                android:key="clipboard_history_preference_fragment"
                android:title="@string/clipboard_history_fragment_title"
                app:summary="@string/clipboard_history_fragment_summary"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:defaultValue="true"
                android:key="clipboard_preview_enable_preference"
                android:summary="@string/pref_clipboard_preview_summary"
                android:title="@string/pref_clipboard_preview_title"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:defaultValue="false"
                android:dependency="clipboard_preview_enable_preference"
                android:key="clipboard_preview_tap_delete_preference"
                android:summary="@string/pref_clipboard_tap_delete_summary"
                android:title="@string/pref_clipboard_tap_delete_title"
                app:iconSpaceReserved="false" />
            <SwitchPreferenceCompat
                android:defaultValue="false"
                android:key="clipboard_delete_unpinned_after_hours_preference"
                android:title="@string/pref_clipboard_delete_unpinned_after_hours_title"
                app:summary="@string/pref_clipboard_delete_unpinned_after_hours_summary"
                app:iconSpaceReserved="false" />
            <SeekBarPreference
                android:defaultValue="1"
                android:dependency="clipboard_delete_unpinned_after_hours_preference"
                android:key="clipboard_unpinned_retention_hours_preference"
                android:max="72"
                android:title="@string/pref_clipboard_unpinned_retention_hours_title"
                app:min="1"
                app:showSeekBarValue="true"
                app:summary="@string/pref_clipboard_unpinned_retention_hours_summary"
                app:iconSpaceReserved="false" />
        </PreferenceCategory>
        <PreferenceCategory
            android:title="@string/back_up"
            app:iconSpaceReserved="false">
            <Preference
                android:key="pref_backup_export"
                android:summary="@string/pref_backup_export_summary"
                android:title="@string/pref_backup_export_title"
                app:iconSpaceReserved="false" />
            <Preference
                android:key="pref_backup_import"
                android:summary="@string/pref_backup_import_summary"
                android:title="@string/pref_backup_import_title"
                app:iconSpaceReserved="false" />
        </PreferenceCategory>
        <PreferenceCategory
            android:title="@string/category_about_app_title"
            app:iconSpaceReserved="false">
            <Preference
                android:key="preference_open_source"
                android:title="@string/open_source_libraries_title"
                app:iconSpaceReserved="false" />
            <Preference
                android:key="app_version_preference"
                android:title="@string/app_version_title"
                app:iconSpaceReserved="false" />
        </PreferenceCategory>
    </PreferenceScreen>
</androidx.preference.PreferenceScreen>
